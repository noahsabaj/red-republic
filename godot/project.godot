; Red Republic — the Godot project.
;
; Scenes, Control layouts, themes and materials live here. All simulation lives
; in crates/sim, and the only Rust that knows this project exists is
; crates/red-republic-shell.

config_version=5

[application]

config/name="Red Republic"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
; Generated by tools/build_icon.py, committed, and the .ico beside it is what
; the executable carries. Without this line an export ships Godot's own robot,
; which is the shape of placeholder the release standard forbids -- and the one
; nobody notices, because it only appears somewhere the editor never shows you.
config/icon="res://icon.png"

; No version here on purpose. The only version number in this repository is
; workspace.package.version in the root Cargo.toml; the menu asks the loaded
; binary for it (Build.version, crates/red-republic-shell/src/build_info.rs) and
; tools/package.ps1 reads it from cargo metadata for the installer and the
; executable's version resource. A copy here could disagree with the binary a
; player is actually running.

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

; Vsync OFF by default during development, and this is not a preference.
;
; With it on, every frame measurement comes back as exactly 16.67 ms whatever
; the load, so a benchmark reports a healthy number for a scene that is
; drowning. Measured on this machine; it silently invalidated a whole probe run
; before anyone noticed.
;
; This value decides only the first moments of a run, and it is NOT what a player
; ends up with. `settings_store.gd` owns that: `display/vsync` defaults true
; there, and `main.gd` calls `apply()` at startup, which sets the mode on the
; DisplayServer unconditionally. So this line is the development default, the
; store holds the shipped one, and a player's vsync is decided in exactly one
; place.
window/vsync/vsync_mode=0
; A `.template_release` override sat here and was removed: it set a value that
; `apply()` overwrites a moment later, so it was a second copy of a shipped
; default that only looked like it did something.

[rendering]

renderer/rendering_method="forward_plus"
; The republic is watched from above and from a distance; a far plane short of
; the map diagonal clips the far side of a 16 km posting.

; Anti-aliasing, and until 2026-07-30 there was NONE of it -- this section held
; one line. Every edge in the game stair-stepped, which is half of what "extremely
; ugly" meant: a roof against the sky, the shore of a lake, a power line.
;
; Both MSAA and TAA, because they cover different things. MSAA fixes geometry
; edges and does nothing for the alpha-tested foliage arriving with the trees;
; TAA fixes that and the shimmer of a tiled ground texture at distance, and
; costs a little smearing while the camera moves.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
; Sky and fog gradients over 6 km are exactly where 8-bit banding shows.
anti_aliasing/quality/use_debanding=true

; A 6 km map is seen almost edge-on at the horizon, which is the case trilinear
; filtering blurs to mush and anisotropic exists for.
textures/default_filters/anisotropic_filtering_level=3

; The shadow map is stretched across whatever range `main.gd::_fit_shadows` asks
; for, which on a framed posting is kilometres. 4096 is not enough resolution to
; spend over that; 8192 is.
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[shader_globals]

; How dark it is, 0 broad daylight to 1 the middle of the night.
;
; A global rather than a parameter on every material, because it is one value
; the whole scene shares and there are a hundred and thirty building materials
; that want it. `main.gd` writes it once a frame from the sun's elevation.
night={
"type": "float",
"value": 0.0
}
