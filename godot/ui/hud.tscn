[gd_scene load_steps=2 format=3]

; The HUD is built in `ui/hud.gd`, so this scene is the node the script hangs
; from and nothing else.
;
; It used to carry the whole layout -- two `StyleBoxFlat`es, thirteen `Label`s
; and a set of literal offsets -- which made it the one screen in the project
; whose look was authored in two places at once. Every other screen is built in
; code for the reason `ui/menu.gd` gives, and the styling now belongs to
; `ui/theme.tres`; a scene file holding a third copy of either would be a third
; thing to keep in step.
;
; It stays a scene rather than becoming a plain node in `main.tscn` because
; `main.tscn` instances it, and a scene boundary is what keeps the HUD's node
; names out of the main scene's namespace.

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")
