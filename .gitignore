# ---- Rust: the live project ----
/target
**/*.rs.bk
*.pdb

# Scratch runners write here — trajectories, baselines, profiling output.
/scratch

# ---- godot/: the shell project ----
# The import cache. Regenerated by `godot --headless --import --path godot`,
# which a virgin checkout has to run once before any GDExtension class resolves
# — without it Godot reports `Cannot get class` and substitutes a placeholder
# node, with no error pointing at the cause.
godot/.godot/
# Editor-local, per-machine.
godot/*.tmp
# Frames written by `-- --shot`, which is a check rather than an asset.
godot/*.png
# ...except the application icon, which is an asset and is committed. This
# exception is load-bearing: without it the rule above silently swallows
# `icon.png`, an export falls back to Godot's own robot, and every check in this
# repository still passes — the icon is the one thing in the build that nothing
# but a human looking at a taskbar can verify.
!godot/icon.png

# Generated by tools/package.ps1, which stamps the version into it from cargo
# metadata. Not committed on purpose: a checked-in preset would carry a second
# copy of the version number, and the copy that goes stale is always the one
# nobody reads. The cost is that Project > Export in the editor shows no preset
# until the script has run once.
godot/export_presets.cfg

# ---- Packaging output ----
/dist

# ---- archive/: the frozen 1.x TypeScript build ----
archive/node_modules
archive/dist
archive/dist-ssr
archive/src-tauri/target
archive/src-tauri/gen
*.local

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent scratchpad
.agents/
