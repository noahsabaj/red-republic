# ---- Rust: the live project ----
/target
**/*.rs.bk
*.pdb

# Scratch runners write here — trajectories, baselines, profiling output.
/scratch

# ---- godot/: the shell project ----
# The import cache. Regenerated by `godot --headless --import --path godot`,
# which a virgin checkout has to run once before any GDExtension class resolves
# — without it Godot reports `Cannot get class` and substitutes a placeholder
# node, with no error pointing at the cause.
godot/.godot/
# Editor-local, per-machine.
godot/*.tmp
# Frames written by `-- --shot`, which is a check rather than an asset.
godot/*.png

# ---- archive/: the frozen 1.x TypeScript build ----
archive/node_modules
archive/dist
archive/dist-ssr
archive/src-tauri/target
archive/src-tauri/gen
*.local

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent scratchpad
.agents/
