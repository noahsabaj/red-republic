[configuration]

; The symbol gdext registers. Wrong name here and Godot loads nothing, reports
; `Cannot get class`, and substitutes a placeholder node -- with no error that
; points at this file.
entry_symbol = "gdext_rust_init"

; gdext 0.5 compiles against API 4.6 and runs on newer runtimes, because the
; forward-compatibility rule is runtime >= API.
compatibility_minimum = 4.1

[libraries]

; Paths are relative to THIS file, not to the project root.
windows.debug.x86_64 = "../target/debug/red_republic_shell.dll"
windows.release.x86_64 = "../target/release/red_republic_shell.dll"
linux.debug.x86_64 = "../target/debug/libred_republic_shell.so"
linux.release.x86_64 = "../target/release/libred_republic_shell.so"
macos.debug = "../target/debug/libred_republic_shell.dylib"
macos.release = "../target/release/libred_republic_shell.dylib"
